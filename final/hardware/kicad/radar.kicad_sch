  (text "Arduino Ultrasonic Radar - full circuit (Arduino Uno R3)"
    (exclude_from_sim no)
    (at 43.18 43.18 0)
    (effects (font (size 2.54 2.54)) (justify left bottom))
    (uuid "4f091432-622e-5bec-8b0d-7f56c58ec2d1"))
  (text "Top wire = breadboard + rail (Uno 5V). Bottom wire = breadboard - rail (Uno GND)."
    (exclude_from_sim no)
    (at 43.18 49.53 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "fa5cb972-1a5b-583d-aa70-d7540ac90694"))
  (text "A dot means wires are joined. Wires that cross without a dot are NOT connected."
    (exclude_from_sim no)
    (at 43.18 53.34 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "393d556e-2f4f-5f86-b79a-b12eeb937898"))
  (text "Power: 9 V battery into the Uno barrel jack (or USB). The rails always carry the Uno's regulated 5 V, never the raw 9 V. C1 sits close to the servo wires to absorb current spikes."
    (exclude_from_sim no)
    (at 38.1 165.1 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "78edf623-106e-5130-8175-bf34b43bf6a2"))
  (text "HC-SR04 is mounted on the servo horn. LEDs: green > 50 cm, yellow 20-50 cm, red < 20 cm."
    (exclude_from_sim no)
    (at 38.1 168.91 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "9888f174-b1bc-5ee8-99aa-6535d3cfb06e"))
  (text "RV1 sets LCD contrast (V0 about 1.2 V). LCD D0-D3 unused (4-bit mode). D0/D1 on the Uno left free for USB serial."
    (exclude_from_sim no)
    (at 38.1 172.72 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "3704453b-f46e-5664-8804-013d18c187d8"))
